#!/bin/sh
# Auto-bump the patch version in version.js on every commit to master.
# version.js is the single source of truth: the UI and the service worker
# CACHE_NAME both read APP_VERSION, so bumping it also busts the SW cache.
#
# Enabled via: git config core.hooksPath .githooks
# Skipped when: not on master, merge in progress, or version.js already staged
# (i.e. you bumped it manually).

branch=$(git symbolic-ref --short -q HEAD)
[ "$branch" = "master" ] || exit 0

[ -e "$(git rev-parse --git-dir)/MERGE_HEAD" ] && exit 0

if git diff --cached --name-only | grep -qx 'version.js'; then
    exit 0
fi

current=$(sed -n "s/^const APP_VERSION = '\(.*\)';.*/\1/p" version.js)
if [ -z "$current" ]; then
    echo "pre-commit: could not read APP_VERSION from version.js — skipping bump" >&2
    exit 0
fi

major=${current%%.*}
rest=${current#*.}
minor=${rest%%.*}
patch=${rest#*.}
new="$major.$minor.$((patch + 1))"

sed -i "s/const APP_VERSION = '$current';/const APP_VERSION = '$new';/" version.js
git add version.js
echo "pre-commit: APP_VERSION bumped $current -> $new"
